///|
/// GnuPG 2.4.5 cross-validation with an RSA key generated by THIS library
/// (rsa1024, user id "MoonBit Tester <moonbit@test.local>", primary key
/// fingerprint 5DC1E21718EB2F136E08D97CC43F37EE4526820A). The key was
/// imported into GnuPG, which accepted it as primary [SC] + subkey [E]:
///
///   gpg --import interop_our_key.asc                    -> imported
///   gpg --armor --encrypt -r moonbit@test.local         -> interop_gpg_encrypted.asc
///   gpg --verify interop_gpg_sig.asc                    -> Good signature
///   gpg --decrypt (our message encrypted to this key)   -> plaintext
///
test "decrypt a GnuPG-encrypted message to our key" {
  let key = @api.PrivateKey::from_armored(
    @fs.read_file_to_string("testdata/interop_our_key.asc"),
  )
  let message = @fs.read_file_to_string("testdata/interop_gpg_encrypted.asc")
  let data = @api.decrypt_with_private_key(message, key)
  assert_eq(data, @primitives.utf8_bytes("gpg encrypts, moonbit decrypts\n"))
}

///|
test "encrypt to our key the way GnuPG decrypts it" {
  // Our own PKESK+SEIPD output for this key was verified with
  // `gpg --decrypt` (see module docs); here we at least ensure our
  // decryption is stable for the same key.
  let key = @api.PrivateKey::from_armored(
    @fs.read_file_to_string("testdata/interop_our_key.asc"),
  )
  let plaintext = @primitives.utf8_bytes("roundtrip through our key")
  let armored = @api.encrypt_to_recipients(plaintext, [key.to_public()])
  assert_eq(@api.decrypt_with_private_key(armored, key), plaintext)
}

///|
test "verify GnuPG's detached signature with our own key" {
  let key = @api.PrivateKey::from_armored(
    @fs.read_file_to_string("testdata/interop_our_key.asc"),
  )
  let status = @api.verify_detached(
    @primitives.utf8_bytes("cross-verify me\n"),
    @fs.read_file_to_string("testdata/interop_gpg_sig.asc"),
    key.to_public(),
  )
  assert_eq(status, @api.Ok)
}
