///|
/// N2 multi-subkey interop against real GnuPG 2.4.5 data: a certificate in
/// the Proton-style shape — Ed25519 certify-only primary, cv25519
/// encryption subkey, Ed25519 signing subkey (generated by
/// `testdata/gen_gpg_dual_subkey_vectors.sh`). Under the pre-N2 single-slot
/// model the import kept only the LAST subkey (here the signing one) and
/// silently dropped the encryption subkey.

///|
test "import a three-component GnuPG certificate" {
  let key = @api.PublicKey::from_armored(
    read_testdata("interop_gpg_dualsub_pub.asc"),
  )
  assert_eq(key.subkeys.length(), 2)
  assert_eq(@packet.PublicKeyPacket::algo(key.primary), @packet.EdDsaLegacy)
  // Wire order: the encryption subkey comes first, the signing subkey last.
  assert_eq(@packet.PublicKeyPacket::algo(key.subkeys[0].key), @packet.Ecdh)
  assert_eq(
    @packet.PublicKeyPacket::algo(key.subkeys[1].key),
    @packet.EdDsaLegacy,
  )
  // Every subkey's own binding verifies over the primary (already enforced
  // at import; assert the standalone entry point too).
  for c in key.subkeys {
    assert_true(@api.verify_key_signature(c.binding, key.primary, c.key))
  }
}

///|
test "a GnuPG signature issued by the signing subkey verifies" {
  let key = @api.PublicKey::from_armored(
    read_testdata("interop_gpg_dualsub_pub.asc"),
  )
  let data = @primitives.utf8_bytes(
    read_testdata("interop_gpg_dualsub_sig.txt"),
  )
  let sig = read_testdata("interop_gpg_dualsub_sig.asc")
  assert_eq(@api.verify_detached(data.exact_view(), sig, key), @api.Ok)
  // And it really is the SUBKEY that signed: the issuer key id is the
  // Ed25519 signing subkey, not the certify-only primary (which is not
  // even a signature candidate for GnuPG here) and not the encryption
  // subkey. This pins the fixture to the multi-subkey verification path.
  let block = @armor.decode(sig)
  let packets = @packet.parse_packets(
    @armor.ArmorBlock::data(block).exact_view(),
  )
  let mut issuer : Bytes? = None
  for p in packets {
    if p.tag() == @packet.Signature {
      let s = @packet.SignaturePacket::parse(p.body().exact_view())
      issuer = s.issuer_key_id()
    }
  }
  assert_true(issuer.unwrap().equal(key.subkeys[1].key.key_id()))
}

///|
test "decrypt a GnuPG message sealed to the encryption subkey" {
  let key = @api.PrivateKey::from_armored(
    read_testdata("interop_gpg_dualsub_key.asc"),
  )
  assert_false(key.is_locked())
  // Both secret subkeys survive the private-key import.
  assert_eq(key.subkeys.length(), 2)
  let plain = @api.decrypt_with_private_key(
    read_testdata("interop_gpg_dualsub_message.asc"),
    key,
  )
  assert_eq(
    plain,
    @primitives.utf8_bytes(read_testdata("interop_gpg_dualsub_sig.txt")),
  )
}

///|
test "our encryption to the dual certificate picks the encryption subkey" {
  let cert = @api.PublicKey::from_armored(
    read_testdata("interop_gpg_dualsub_pub.asc"),
  )
  let secret = @api.PrivateKey::from_armored(
    read_testdata("interop_gpg_dualsub_key.asc"),
  )
  let data = @primitives.utf8_bytes("moonpgp to the dual cert\n")
  let armored = @api.encrypt_to_recipients(data, [cert])
  // Had the selection picked the (last-on-wire) Ed25519 signing subkey,
  // create_pkesk would have refused to encrypt; the round trip through the
  // cv25519 subkey proves the flags-aware choice.
  assert_eq(@api.decrypt_with_private_key(armored, secret), data)
}

///|
test "a gpg-generated revocation certificate applies to our key model" {
  let key = @api.PublicKey::from_armored(
    read_testdata("interop_gpg_dualsub_pub.asc"),
  )
  let now = @primitives.unix_now()
  assert_false(key.is_revoked(now))
  // The .rev file gpg auto-generates at key creation (text preamble plus
  // PUBLIC KEY BLOCK armor holding the revocation signature).
  let revoked = key.apply_revocation_certificate(
    read_testdata("interop_gpg_dualsub_revcert.asc"),
  )
  assert_true(revoked.is_revoked(now))
}

///|
test "our subkey revocation rejects gpg's subkey-issued signature" {
  // Revoke the SIGNING subkey of the gpg certificate (using gpg's own
  // secret key), then the real gpg signature from the fixture must verify
  // as KeyRevoked instead of Ok.
  let secret = @api.PrivateKey::from_armored(
    read_testdata("interop_gpg_dualsub_key.asc"),
  )
  let pub_key = @api.PublicKey::from_armored(
    read_testdata("interop_gpg_dualsub_pub.asc"),
  )
  let signing_sub_id = pub_key.subkeys[1].key.key_id()
  let revoked = @api.revoke_subkey(
    secret,
    signing_sub_id.exact_view(),
    reason=@api.Compromised,
    message="signing stick lost",
  )
  let revoked_pub = @api.PrivateKey::from_bytes(revoked.to_bytes().exact_view()).to_public()
  let data = @primitives.utf8_bytes(
    read_testdata("interop_gpg_dualsub_sig.txt"),
  )
  let sig = read_testdata("interop_gpg_dualsub_sig.asc")
  assert_eq(
    @api.verify_detached(data.exact_view(), sig, revoked_pub),
    @api.KeyRevoked,
  )
}

///|
test "gpg's embedded cross-certification verifies with our code" {
  let key = @api.PublicKey::from_armored(
    read_testdata("interop_gpg_dualsub_pub.asc"),
  )
  let signing = key.subkeys[1]
  // The binding of the signing subkey carries the embedded PrimaryKeyBinding
  // (subpacket 32) in its unhashed area.
  let mut embedded : @packet.SignaturePacket? = None
  for sp in signing.binding.unhashed_subpackets() {
    if sp.sub_type() == @packet.SIGSUB_EMBEDDED_SIGNATURE {
      embedded = Some(@packet.SignaturePacket::parse(sp.body().exact_view()))
    }
  }
  let emb = embedded.unwrap()
  assert_eq(emb.sig_type(), @packet.PrimaryKeyBinding)
  assert_true(@api.verify_key_signature(emb, signing.key, key.primary))
}
