///|
/// Callback recorder for the gpg MIME interop tests below.
struct MimeRecorder {
  bodies : Array[(String, String)]
  attachments : Array[(Array[(String, String)], Bytes)]
  verified : Array[@api.VerifyStatus]
  errors : Array[String]
}

///|
fn new_recorder() -> MimeRecorder {
  MimeRecorder::{ bodies: [], attachments: [], verified: [], errors: [], }
}

///|
impl @mime.MimeCallbacks for MimeRecorder with fn on_body(self, body, mimetype) {
  self.bodies.push((body, mimetype))
}

///|
impl @mime.MimeCallbacks for MimeRecorder with fn on_attachment(
  self,
  headers,
  data,
) {
  self.attachments.push((headers, data))
}

///|
impl @mime.MimeCallbacks for MimeRecorder with fn on_verified(self, status) {
  self.verified.push(status)
}

///|
impl @mime.MimeCallbacks for MimeRecorder with fn on_error(self, message) {
  self.errors.push(message)
}

///|
/// GnuPG cross-validation of the full decrypt_mime pipeline (vectors
/// regenerated by testdata/gen_gpg_mime_vectors.sh, gpg 2.4.5):
/// gpg-encrypted multipart/signed mail whose inner signature gpg created
/// over the exact part bytes (RFC 1847 headers+body coverage).
test "gpg encrypted signed pgp/mime: full pipeline ok" {
  let key = @api.PrivateKey::from_armored(
    @fs.read_file_to_string("testdata/interop_our_key.asc"),
  )
  let message = @fs.read_file_to_string(
    "testdata/interop_gpg_mime_encrypted_signed.eml.asc",
  )
  let cb = new_recorder()
  @mime.decrypt_mime(message, [key], verifiers=[key.to_public()], callbacks=cb)
  assert_eq(cb.errors, [])
  // Embedded side is NotSigned (no inline sig); MIME side verifies -> Ok.
  assert_eq(cb.verified, [@api.Ok])
  assert_eq(cb.bodies.length(), 1)
  assert_true(cb.bodies[0].0.contains("Mime body for gpg interop."))
  assert_true(cb.bodies[0].0.contains("Second line."))
  assert_eq(cb.bodies[0].1, "text/plain")
  assert_eq(cb.attachments.length(), 0)
}

///|
test "gpg encrypted signed pgp/mime: tampered body fails" {
  let key = @api.PrivateKey::from_armored(
    @fs.read_file_to_string("testdata/interop_our_key.asc"),
  )
  let message = @fs.read_file_to_string(
    "testdata/interop_gpg_mime_tampered.eml.asc",
  )
  let cb = new_recorder()
  @mime.decrypt_mime(message, [key], verifiers=[key.to_public()], callbacks=cb)
  // Embedded NotSigned + MIME Failed -> both errors, status Failed
  // (gopenpgp scenario_13 shape); body is still delivered.
  assert_eq(cb.errors.length(), 2)
  assert_eq(cb.verified, [@api.Failed])
  assert_eq(cb.bodies.length(), 1)
  assert_true(cb.bodies[0].0.contains("TAMPERED body"))
}

///|
/// gpg --encrypt --sign: embedded one-pass signature inside
/// SEIPD+Compressed over a multipart/mixed text; body and attachment are
/// collected and the embedded signature verifies.
test "gpg encrypt+sign mime: embedded signature ok with attachment" {
  let key = @api.PrivateKey::from_armored(
    @fs.read_file_to_string("testdata/interop_our_key.asc"),
  )
  let message = @fs.read_file_to_string("testdata/interop_gpg_mime_es.asc")
  let cb = new_recorder()
  @mime.decrypt_mime(message, [key], verifiers=[key.to_public()], callbacks=cb)
  assert_eq(cb.errors, [])
  assert_eq(cb.verified, [@api.Ok])
  assert_eq(cb.bodies, [("inline signed mime body", "text/plain")])
  assert_eq(cb.attachments.length(), 1)
  let (headers, data) = cb.attachments[0]
  assert_eq(data, @primitives.utf8_bytes("ATTACHMENTBYTES"))
  let mut have_filename = false
  for pair in headers {
    if pair.0.to_lower() == "content-disposition" && pair.1.contains("a.bin") {
      have_filename = true
    }
  }
  assert_true(have_filename)
}
