import {
  "justinwongcn/moonpgp/api",
  "justinwongcn/moonpgp/error",
  "moonbitlang/async/io",
  "moonbitlang/async/socket",
  "moonbitlang/async/tls",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/x/fs",
}

// `async test` requires the async runtime package; only the white-box
// SMTP tests reference it (main imports stay lean for wasm).
import {
  "moonbitlang/async",
} for "wbtest"

// `@socket` and `@tls` are referenced only from `#cfg(target="native")`
// code (transport_tls.mbt, async_sock.mbt). moon.pkg cannot express
// target-conditional imports yet, so on wasm/js the imports are flagged
// unused; the transports are native-only by design (socket_stub.mbt).

warnings = "-unused_package"
